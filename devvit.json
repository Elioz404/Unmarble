{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "unmarble",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": { "entry": "card.html", "height": "tall" },
      "game": { "entry": "game.html" }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": { "enable": true }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/app-install",
    "onAppUpgrade": "/internal/triggers/app-upgrade",
    "onCommentCreate": "/internal/triggers/comment-create",
    "onCommentDelete": "/internal/triggers/comment-delete",
    "onPostDelete": "/internal/triggers/post-delete",
    "onModAction": "/internal/triggers/mod-action"
  },
  "scheduler": {
    "tasks": {
      "daily-sheet": { "endpoint": "/internal/scheduler/daily-sheet", "cron": "0 0 * * *" },
      "tally-names": { "endpoint": "/internal/scheduler/tally-names", "cron": "17 * * * *" }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Unmarble: post today’s sheet",
        "description": "Creates today’s sheet post now if it is missing",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      },
      {
        "label": "Unmarble: clear this sheet’s name",
        "description": "Removes the community name from this sheet",
        "location": "post",
        "forUserType": "moderator",
        "postFilter": "currentApp",
        "endpoint": "/internal/menu/clear-name"
      }
    ]
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
